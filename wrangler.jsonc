// Cloudflare Workers config: serves the static Astro build in dist/ (no server code).
// Needed for preview builds (`wrangler preview`) and keeps production
// deploys from auto-configuring the project. "name" must match the Worker in Cloudflare.
{
  "name": "raymond-sg",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which Cloudflare runs for preview builds.
  // Assets and other settings stay at the top level.
  "previews": {}
}
