---
import { site } from '../data/site';

const cards = [
  { n: '01 / Enterprise', title: 'Platforms that talk to each other', body: 'Salesforce, Jira Service Management, Business Central, SAP Commerce Cloud and Shopline, integrated and rolled out across more than one market.', k: 'Scope', v: 'Multi-market' },
  { n: '02 / Product', title: 'Software I build and run', body: 'I own the whole thing: the data model, the interface, the tests, the deploy and keeping it running afterwards.', k: 'Range', v: 'Web · Extension · Desktop' },
  { n: '03 / Principles', title: 'Simple to run, light on data', body: 'Where I can, the work happens on your own device: 9toFIRE runs its simulations in the browser, and my Windows tools never send your files or lists anywhere. I test before anything ships and keep hosting lean, mostly on free tiers.', k: 'Default', v: 'Local first' },
];
---
<section class="pt-14 pb-20 sm:pt-16 lg:pt-24 lg:pb-28 border-b border-monolith-line dark:border-monolith-darkLine">
  <div class="flex flex-col gap-6 max-w-4xl">
    <p class="eyebrow">{site.role}</p>
    <h1 class="text-[2.5rem] sm:text-6xl lg:text-[4.25rem] font-medium leading-[1.06] tracking-tightest">
      I deliver enterprise systems <span class="italic font-normal font-serif muted">across APAC</span>, and build and run software of my own.
    </h1>
    <p class="text-base sm:text-lg muted leading-relaxed max-w-2xl pt-2">My day-to-day is business systems that run across several markets: CRM, ITSM, ERP and e-commerce. I've also been building software of my own for years, starting with Windows tools that have since been downloaded hundreds of thousands of times, and now web apps and browser extensions.</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-monolith-line dark:bg-monolith-darkLine mt-14 sm:mt-16 border border-monolith-line dark:border-monolith-darkLine rounded-sm overflow-hidden">
    {cards.map((c) => (
      <div class="bg-monolith-canvas dark:bg-monolith-darkCard p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <p class="eyebrow mb-4">{c.n}</p>
          <h2 class="text-base font-semibold tracking-tight mb-2">{c.title}</h2>
          <p class="text-sm leading-relaxed muted">{c.body}</p>
        </div>
        <p class="card-foot"><span>{c.k}</span><span class="foot-value">{c.v}</span></p>
      </div>
    ))}
  </div>
</section>
