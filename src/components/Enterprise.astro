---
import { enterprise } from '../data/enterprise';
---
<section id="enterprise" class="scroll-mt-24 py-14 sm:py-20 lg:py-24 border-b border-monolith-line dark:border-monolith-darkLine">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-10 gap-4">
    <div>
      <p class="eyebrow mb-2">Enterprise work</p>
      <h2 class="text-3xl sm:text-4xl font-medium tracking-tight">Platforms I have delivered</h2>
    </div>
    <p class="text-xs uppercase tracking-editorial muted">Across Asia-Pacific markets</p>
  </div>
  <ol class="grid grid-cols-1 md:grid-cols-2 gap-px bg-monolith-line dark:bg-monolith-darkLine border border-monolith-line dark:border-monolith-darkLine rounded-sm overflow-hidden">
    {enterprise.map((e, i) => (
      <li class="bg-monolith-card dark:bg-monolith-darkCard p-7 flex flex-col gap-2.5">
        <p class="eyebrow">{String(i + 1).padStart(2, '0')} / {e.category}</p>
        <h3 class="text-lg font-semibold tracking-tight leading-snug">{e.title}</h3>
        <p class="text-sm muted leading-relaxed">{e.summary}</p>
        <div class="mt-auto pt-4 border-t border-monolith-line dark:border-monolith-darkLine space-y-2">
          <p class="text-[13px] leading-snug"><span class="muted">My role: </span>{e.role}</p>
          <p class="font-mono text-xs muted">{e.tools}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
