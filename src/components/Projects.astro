---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<section id="projects" class="scroll-mt-24 py-14 sm:py-20 lg:py-24 border-b border-monolith-line dark:border-monolith-darkLine">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-12 gap-4">
    <div>
      <p class="eyebrow mb-2">Own projects</p>
      <h2 class="text-3xl sm:text-4xl font-medium tracking-tight">Things I've built</h2>
    </div>
    <p class="text-xs uppercase tracking-editorial muted">Designed, built and shipped end to end</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
