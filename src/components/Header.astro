---
import { site } from '../data/site';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#enterprise', label: 'Enterprise' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#tools', label: 'Tools' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="sticky top-0 z-50 bg-monolith-canvas/95 dark:bg-monolith-darkCanvas/95 border-b border-monolith-line dark:border-monolith-darkLine">
  <div class="max-w-[1360px] mx-auto px-5 sm:px-6 lg:px-12 h-16 sm:h-20 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4 sm:gap-6 min-w-0">
      <a id="home-link" class="group flex items-center gap-3 min-w-0" href="/" aria-label="Raymond Lin, home">
        <span class="shrink-0 w-8 h-8 rounded-sm bg-monolith-ink dark:bg-white text-white dark:text-monolith-ink flex items-center justify-center font-mono font-bold text-xs tracking-wider transition-colors group-hover:bg-monolith-accent dark:group-hover:bg-monolith-accent dark:group-hover:text-white">RL</span>
        <span class="flex flex-col min-w-0">
          <span class="text-sm font-semibold tracking-tight uppercase whitespace-nowrap">{site.name}</span>
          <span class="hidden sm:block text-[10px] tracking-looseCap muted uppercase font-medium whitespace-nowrap">{site.role}</span>
        </span>
      </a>
      <span class="h-4 w-px bg-monolith-line dark:bg-monolith-darkLine hidden xl:inline-block"></span>
      <span class="text-xs tracking-editorial muted uppercase font-medium hidden xl:inline-block">Singapore</span>
    </div>
    <nav aria-label="Primary" class="flex items-center gap-5 lg:gap-8 text-xs tracking-editorial uppercase font-medium">
      {links.map((l) => <a class="nav-link hidden lg:inline-block" href={l.href}>{l.label}</a>)}
      <span class="flex items-center gap-2 -mr-1.5">
        <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" class="lg:hidden w-11 h-11 rounded-full border border-monolith-line dark:border-monolith-darkLine flex items-center justify-center muted hover:border-monolith-accent transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path class="menu-open" d="M4 7h16M4 12h16M4 17h16"></path><path class="menu-close hidden" d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
        <button id="theme-toggle" type="button" aria-label="Switch to dark theme" class="w-11 h-11 rounded-full border border-monolith-line dark:border-monolith-darkLine flex items-center justify-center muted hover:border-monolith-accent transition-colors">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none"></path></svg>
        </button>
      </span>
    </nav>
  </div>
  <nav id="mobile-menu" aria-label="Sections" hidden class="lg:hidden border-t border-monolith-line dark:border-monolith-darkLine">
    <ul class="max-w-[1360px] mx-auto px-5 sm:px-6 py-2">
      {links.map((l) => (
        <li><a class="flex items-center min-h-[48px] text-sm tracking-editorial uppercase font-medium muted hover:text-monolith-accentHover dark:hover:text-[#FB923C]" href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
